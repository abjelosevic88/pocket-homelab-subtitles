TZ=Europe/Berlin
# Start the Bazarr that comes with Pocket Subtitles. Remove this line (and run
# `docker compose stop bazarr`) to use your own Bazarr at BAZARR_URL instead.
COMPOSE_PROFILES=bazarr
# Your media (shows/ and movies/ inside); default: media next to this file
# MEDIA_FOLDER=/srv/media
# Your own Bazarr:
# BAZARR_URL=http://bazarr:6767
# BAZARR_API_KEY=
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
